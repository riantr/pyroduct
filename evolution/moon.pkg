// 进化层：变异空间 / 适应度目标 / 更新闸门 / 持久化 / 遗传。依赖 multi（行为规则）
// 与 core/string（持久化的解析）、core/math（关联诊断的熵）；`cycle.mbt` 另依赖
// src（位置 × 驱动槽的执行契约）与 group（群体层「一句触发、两个去处」的裁决：
// 群体机如实给 Open，由本层的双诚之比决定偏向哪边——同一根轴，主体机用它选
// 空间侧／时间侧，群体机用它选共辩／共见）。
import {
  "riantr/pyroduct/src" @sm,
  "riantr/pyroduct/group" @g,
  "riantr/pyroduct/multi",
  "riantr/pyroduct/ml",
  "moonbitlang/core/string",
  "moonbitlang/core/math",
}
