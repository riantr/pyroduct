// 因果诊断层（0.163.3 深用）：引入 riantr/moonbit_doubleML 做三类只读分析——
// 敏感性（隐藏混杂多强才推翻结论）、多重检验校正（批量闸门的假发现率）、
// BLP 异质性（效应落在哪个维度）。数据一律来自状态机（ml.make_dataset）。
// 只读诊断，不设闸门：更新闸门仍在 evolution，不因 0.163.3 扩展而改判据。
//
// 「0.163.3 深用」说的是**功能出处**：这三类诊断是 0.163.3 带来的。本层钉的
// 版本是 0.164.34，而 0.164.34 与 0.163.3 的公开接口逐字节相同（module index
// 两版都是 29687 字节，导出集一致），所以「深用」的那套能力一字未改；改钉版本
// 是为了跟上上游，不是为了换一套新能力。库也没有导出正态尾函数，故 p 值自备。
import {
  "riantr/pyroduct/ml",
  "riantr/moonbit_doubleML" @dml,
  "moonbitlang/core/math",
}

supported_targets = "native+wasm+wasm-gc+js"
