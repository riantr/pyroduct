///|
/// 多主体行为规则表：十二条规则，每条都给出文本依据。

///|
/// 一条行为规则。
pub struct Rule {
  code : String
  name : String
  text : String
  basis : String
}

///|
/// 全部规则（R1–R12）。
pub fn rules() -> Array[Rule] {
  [
    {
      code: "R1",
      name: "体制优先",
      text: "双方行为由其「如何对待主体性」决定，而非由其具体论点决定；先辨认体制，再谈内容。",
      basis: "分歧源于对主体的态度；真理观的区别才是诸多差异的根本原因。",
    },
    {
      code: "R2",
      name: "不独断",
      text: "任何主体都不得把「真理」设为终局状态；系统里不存在 Truth 这样的终态，一切断语带可修订标记。",
      basis: "独断且完全地描述真理是不可能任务，是形而上学残余的尾骨。",
    },
    {
      code: "R3",
      name: "解蔽—遮蔽",
      text: "每次交互同时产出「显」（可共享的表述）与「隐」（未穷尽者）；隐永远非空。",
      basis: "真理是解蔽事件；大地—世界一隐一显，合和于作品之中。",
    },
    {
      code: "R4",
      name: "有效性时序",
      text: "真诚性正位于事前、真实性正位于事中、正当性正位于事后；错位提出即为越界，主张者让位。",
      basis: "三有效性主张的时间结构：事前／事中／事后。",
    },
    {
      code: "R5",
      name: "两诚区分",
      text: "他之诚（言语内容之契合）与己之诚（行为与意向之契合）分别成立，不可相代；且他之诚不进入共同检讨。",
      basis: "Authentizität→他之诚、Wahrhaftigkeit→己之诚；除他之诚外，其它都须由主体之间共同检讨。",
    },
    {
      code: "R6",
      name: "弃符合论、存方法",
      text: "禁止以「命题与事态相符」作为裁决程序；但保留方法性的先行关系。",
      basis: "符合论已成昨日黄花；精神科学里本质性东西不是客观性，而是同对象的先前关系。",
    },
    {
      code: "R7",
      name: "构成性",
      text: "实践内在地构成认识：交互中的实践结果必须回写进双方的认识状态，而不是外加的范导性约束。",
      basis: "伽、哈二者都属构成性而非范导性；实践需要内在地包含在认识之中。",
    },
    {
      code: "R8",
      name: "第三者",
      text: "超主体性体制把第三者交给绝对者（语言被绝对化即滑向投射）；主体间性体制交给理性与关系网络。",
      basis: "伽达默尔处第三者只能由上帝扮演；哈贝马斯以理性为根基，纵横交织成网。",
    },
    {
      code: "R9",
      name: "商谈类型",
      text: "理论／实践／表达／信仰四类商谈各有其有效性主张；信仰商谈可纳入共识真理。",
      basis: "指向主观世界的商谈可称「信仰商谈」；宗教真理亦可纳入共识真理理论。",
    },
    {
      code: "R10",
      name: "谬误残余",
      text: "每个主体、每次断语都携带不可消尽的谬误残余；残余不会被压到零。",
      basis: "任何个人的见解中，始终都有谬误的残余，本文作者也一样。",
    },
    {
      code: "R11",
      name: "不可闭合",
      text: "被说出的文字不是僵死的；每次达成的共识都保留可修订标记，历史不得冻结。",
      basis: "克尔恺郭尔的寓言：文字还在生长——真理问题果真有一个最终的结论吗？",
    },
    {
      code: "R12",
      name: "诚然相契",
      text: "当双方皆处诚然体制且双诚俱足，交锋可越过对抗，统于自性内照，入于无人我、齐万物之境。",
      basis: "澄然与诚然尚可统于「自性内照」，其后乃能入于「无人我、齐万物」之境。",
    },
    {
      code: "R13",
      name: "横检纵共",
      text: "横向与纵向是同一张网的两条线：横向＝各有效性主张须由主体之间相互检讨；纵向＝参与商谈者必须共同具备理性。二者齐备，才可能有无强制的共识。",
      basis: "「横向」的有效性主张与「纵向」的共同理性织成的那张网，构成达成无强制共识的基础。",
    },
    {
      code: "R14",
      name: "共识即建议",
      text: "任何达成的共识只能以「建议」的形式发布：参与者始终可以拒收，不得以宣告的形式替对方作结。",
      basis: "「真理」只不过是一种表达，利用这种表达，我们可以建议我们的话语伙伴接受我们认为是正确的观念。",
    },
  ]
}

///|
/// 按编号取一条规则。
pub fn rule(code : String) -> Rule? {
  for r in rules() {
    if r.code == code {
      return Some(r)
    }
  }
  None
}

///|
/// 每条规则的文本依据（章／节／页；页号取自 truth.pdf 正文）。
pub fn citations() -> Array[(String, String)] {
  [
    (
      "R1", "第四章第一节（P.29）：真理观的区别才是他们之间存在诸多差异的根本原因",
    ),
    (
      "R2", "第四章第六节（P.52）：独断且完全地描述乃是一种不可能的任务，是形而上学残余的尾骨",
    ),
    (
      "R3", "第四章第六节（P.53）：真理是一个解蔽事件，我们每一个言说着的人都身在其中",
    ),
    (
      "R4", "第三章第五节（P.27）：真诚性＝事前、真实性＝事中、正当性＝事后",
    ),
    (
      "R5", "第三章第二节（P.23-24）：他之诚＝言语内容之契合；己之诚＝行为与意向之契合",
    ),
    ("R6", "第四章第三节 2（P.32）：对符合论的批判"),
    (
      "R7", "第五章余论（P.54）：引普特南之分，伽、哈二者都属构成性",
    ),
    (
      "R8", "第四章第五节（P.48）：第三者由于其超脱性只能由上帝来扮演",
    ),
    (
      "R9", "第三章第四节 6（P.45）：信仰商谈；宗教真理亦可纳入共识真理",
    ),
    (
      "R10", "第四章第六节（P.51）：任何个人的见解中，始终都有谬误的残余",
    ),
    (
      "R11", "第四章第六节（P.53）：文字不是已被说出的僵死之物，它还在生长",
    ),
    (
      "R12", "第五章余论（P.55）：澄然与诚然尚可统于自性内照",
    ),
    (
      "R13", "第四章第五节（P.50）：横向的有效性主张与纵向的共同理性织成主体间性之网",
    ),
    (
      "R14", "第四章第五节（P.50）：真理只不过是一种表达，用它建议话语伙伴接受",
    ),
  ]
}

///|
/// 按编号取文本依据。
pub fn citation_of(code : String) -> String {
  for c in citations() {
    if c.0 == code {
      return c.1
    }
  }
  ""
}
