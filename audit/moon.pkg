// 自审计层（三鉴的「参考消费者」）：把真实主体机的表转成纯数据
// MachineSpec（34 状态 · 53 迁移 · 49 触发 → 8 槽 · 228 无路组合 · 修习历程），
// 交给 riantr/moonbit_static_analysis/src/statecheck 审计——结构鉴（状态即
// 绑定：绑定／进入／可达）、类型鉴（注解即契约：无路必须说出口）、行为鉴
// （历程抽象执行）。「鉴」兼照镜与审察二义。已知设计使然的发现（无忆／无筹
// 只出不进）在报告里注明出处层，未预期发现必须为零（回归绊线）。
// 0.1.28 起 fleet.mbt 把同一套三鉴扩到群体机与社会机（两台机**没有驱动槽**，
// 故类型鉴的槽层整层跳过，见该文件头的说明）。
// 本层只读：不改判据、不修表。
import {
  "riantr/pyroduct/src" @sm,
  "riantr/pyroduct/group" @g,
  "riantr/pyroduct/society" @so,
  "riantr/moonbit_static_analysis/src/statecheck" @sa,
  "riantr/moonbit_static_analysis/src/report" @sareport,
  "riantr/moonbit_static_analysis/src/core" @sacore,
  "riantr/moonbit_static_analysis/src/moonfiles" @safiles,
}

// `iface_data.mbt` 是生成的快照：一屏一行的长字符串字面量，格式化器改它只会徒增
// diff 噪声。真伪由 `tools/ifacescan` 的 native 判据守着（逐字节比对磁盘）。
formatter(ignore: [ "iface_data.mbt" ])

supported_targets = "native+wasm+wasm-gc+js"
