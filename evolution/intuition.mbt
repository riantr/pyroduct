///|
/// 「直觉」的读法（`intuition.mbt`）。
///
/// 把裁决备忘录（`replay.mbt`）读成背景直觉的仓库：哈贝马斯把不曾主题化、却
/// 时刻从中取用的背景知识叫**背景直觉**；仓库把生活世界引为「自我理解或坚定
/// 不移信念的仓库」（P.43-44）。`DecisionMemo` 就是这个仓库的最小形式形状——
/// 一次裁决存下来，下次同一键到来时不重走推导、直接取回。重复计算的反面不是
/// 「算得快」，是「认出」。
///
/// 出处层：**模型整理**。「背景直觉」与「前见」的修复是论文两极的词汇，不是
/// 原文直述的语料；本文件是读法，不是新槽（归位纪律不许合并因果上不同的东西）。

///|
/// 直觉读法全文，供 CLI 直接打印。
pub fn intuition_principle() -> String {
  let text =
    #|直觉读法（模型整理）：把裁决备忘录读成背景直觉的仓库。
    #|
    #|哈贝马斯把不曾主题化、却时刻从中取用的背景知识叫「背景直觉」；生活世界是
    #|「自我理解或坚定不移信念的仓库」（P.43-44）。裁决备忘录就是它的最小形式形状：
    #|一次裁决存下来，下次同一键到来时不重走推导、直接取回。重复计算的反面不是
    #|「算得快」，是「认出」——memo 命中＝从仓库取用一项背景直觉；「[与回合 N 同判·
    #|不重裁]」＝这项直觉的出处进了账本。
    #|
    #|直觉是判断的 mode，不是第九个槽：它的取回动作落在「持存」（不断将所经历的
    #|吸入、沉淀），检验动作落在「揭蔽」（追问自身是什么）。按归位纪律，因果上
    #|不同的东西不合并——本层不新增槽，只新增读法。
    #|
    #|四条纪律（缺一即盲目前见，不是直觉）：
    #|  出处可查——键与首裁回合都进账本；说不出出处的前见是盲目的。
    #|  在接触中存活或破碎——先比较输出：输出未变＝沉淀为经验；变了＝判断力接管。
    #|  出处层即稳固度——「原文直述」裁下的直觉不随「模型整理」修订而动摇。
    #|  不编造命中——没有键命中就悬置：未定不掷骰子，无路是合法回执。
    #|
    #|两极在此和解：伽达默尔修复「前见」（携带既往裁决继续走＝备忘录）；哈贝马斯
    #|要求前见过闸门（修习不是意愿问题，是证据问题）。携带且检验，出处可查，
    #|永不宣称终局——循环经过的每个位置仍有出边（不封闭，共识只作建议）。
  text
}

///|
/// 四条纪律：直觉与盲目前见的分界。每行（纪律, 落点）。
pub fn intuition_disciplines() -> Array[(String, String)] {
  [
    (
      "出处可查", "键与首裁回合都进账本（[与回合 N 同判·不重裁]）——说不出出处的前见是盲目的",
    ),
    (
      "在接触中存活或破碎", "先比较输出：输出未变＝前见沉淀为经验；变了＝判断力接管、重新推导",
    ),
    (
      "出处层即稳固度", "「原文直述」裁下的直觉不随「模型整理」修订而动摇（派生表持久度清单可查）",
    ),
    (
      "不编造命中", "没有键命中就悬置：未定不掷骰子，无路是合法回执——机器从不伪造一步",
    ),
  ]
}
